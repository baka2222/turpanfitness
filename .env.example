# ── PostgreSQL (shared by admin, backend API and bot) ────────────────────────
POSTGRES_DB=turpan
POSTGRES_USER=turpan
POSTGRES_PASSWORD=change-me-to-a-strong-password   # keep it URL-safe (no @ : / #)

# ── Django admin ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Set to your real host(s) once behind a domain, e.g. admin.turpan.kg
DJANGO_ALLOWED_HOSTS=*
# REQUIRED for admin login over HTTPS/Cloudflare — list your public origin(s):
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,https://your-domain.com
# Auto-created on first `up` if it doesn't exist yet:
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# ── FastAPI backend ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://your-domain.com

# ── Telegram bot / lead notifications ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
